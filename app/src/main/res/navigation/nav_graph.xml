<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.inovagab.presentation.splash.SplashFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.inovagab.presentation.login.LoginFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_login_to_operator"
            app:destination="@id/operatorMainFragment" />
        <action
            android:id="@+id/action_login_to_manager"
            app:destination="@id/managerMainFragment" />
        <action
            android:id="@+id/action_login_to_leadership"
            app:destination="@id/leadershipMainFragment" />
    </fragment>

    <fragment
        android:id="@+id/operatorMainFragment"
        android:name="com.inovagab.presentation.operator.OperatorMainFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/managerMainFragment"
        android:name="com.inovagab.presentation.manager.ManagerMainFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/leadershipMainFragment"
        android:name="com.inovagab.presentation.leadership.LeadershipMainFragment"
        android:label="@string/nav_home" />

</navigation>
